# Django Core
# Note: Docker Compose env_file passes quotes literally; keep values unquoted.
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL / PostGIS
DATABASE_NAME=termit_docker
DATABASE_USER=termit_user
DATABASE_PASS=change-me-db-password
DATABASE_HOST=termit_db
DATABASE_PORT=5432

# Redis (docker-compose)
REDIS_PASSWORD=change-me-redis-password

# Origins & Domains
HOSTNAME=http://localhost:8000
# MAP_ORIGIN=https://xarita.academy.uz
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT Auth Cookies
# Leave AUTH_COOKIE_DOMAIN unset for single-host / localhost; set .academy.uz to share across subdomains.
# AUTH_COOKIE_DOMAIN=.academy.uz
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_HTTP_ONLY=True
AUTH_COOKIE_SAMESITE=Lax

# OneID OAuth
CLIENT_ID=your-oneid-client-id
CLIENT_SECRET=your-oneid-client-secret
SCOPE=your-oneid-scope
REDIRECT_URI=http://localhost:5173/auth

# Super Access (/auth/super-access) - disabled unless ENABLED_SUPER_ACCESS=True and both secrets are set.
# Set LOCAL=True (alongside DEBUG=True) to skip key & Google Authenticator prompt on localhost.
# Generate values with: python manage.py setup_super_access
ENABLED_SUPER_ACCESS=False
LOCAL=False
SUPER_ACCESS_KEY=
SUPER_ACCESS_TOTP_SECRET=

# OS Geo Libraries (set True on Windows OSGeo4W)
WIN_OS=False

# IIP Integration
iip_username=your-iip-username
iip_password=your-iip-password
ConsumerKey=your-consumer-key
ConsumerSecret=your-consumer-secret
tin=your-organization-tin

# Gunicorn (optional, used by entrypoint.sh)
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
